# ============================================================================
# Compliance Sentinel — ПРИМЕР переменных окружения.
#
# ВАЖНО: это публичный шаблон. Не вписывайте сюда реальные токены и ключи —
# только в локальный .env, который исключён из Git через .gitignore.
#
# Скопируйте файл и заполните значения:
#   cp .env.example .env          (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ============================================================================

# --- Обязательные переменные -------------------------------------------------

# GitHub Personal Access Token.
# Classic: scope "repo"; Fine-grained: Contents (Read), Pull requests (Read/write),
# Commit statuses (Read/write), Metadata (Read).
# Сюда значение не вписывайте — заполните в .env.
GITHUB_TOKEN=

# Секрет вебхука. Придумайте длинную случайную строку (например, token_hex(32))
# и укажите точно такой же Secret при создании вебхука в GitHub.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# API-ключ LLM-провайдера.
# Groq: https://console.groq.com/keys (ключ gsk_...)
# DeepSeek: https://platform.deepseek.com/api_keys (ключ sk-...)
GROQ_API_KEY=

# --- Необязательные настройки (значения по умолчанию указаны) ----------------

# Адрес GitHub API. Меняйте только для GitHub Enterprise.
GITHUB_API_URL=https://api.github.com

# Проект работает с любым OpenAI-совместимым API. Исторические имена
# переменных GROQ_* сохранены для совместимости с исходным ТЗ.
# Полный endpoint Groq (можно указать базовый URL .../v1):
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Альтернатива DeepSeek (если Groq недоступен, например из РФ):
# GROQ_API_URL=https://api.deepseek.com

# Модель Groq.
GROQ_MODEL=llama-3.3-70b-versatile
# Модель DeepSeek для альтернативы:
# GROQ_MODEL=deepseek-flash

# Контекст commit status. Именно эту строку нужно добавить в branch protection
# как обязательную проверку.
STATUS_CONTEXT=Compliance Sentinel

# Ограничения и таймауты.
MAX_DIFF_CHARS=80000
HTTP_TIMEOUT_SECONDS=30
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_RETRIES=2
MAX_CONCURRENT_AUDITS=4

# Публичный URL сервиса (например, https://your-subdomain.ngrok-free.app).
# Используется как target_url (ссылка Details) в commit status. Можно оставить пустым.
PUBLIC_BASE_URL=

# Необязательный allow-list репозиториев в формате owner/repo через запятую.
# Пусто = разрешены все репозитории, к которым у токена есть доступ.
ALLOWED_REPOSITORIES=

# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
